        <mxCell id="note_self" value="Self-reference:&lt;br&gt;ManagerID → EmployeeID" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="1150" y="225" width="130" height="40" as="geometry"/>
        </mxCell>

        <!-- ================= EXPLANATION ================= -->
        <mxCell id="box_keys" value="&lt;b&gt;Primary Keys (PK)&lt;/b&gt;&lt;br&gt;• Customers.CustomerID&lt;br&gt;• Products.ProductID&lt;br&gt;• Employees.EmployeeID&lt;br&gt;• Orders.OrderID&lt;br&gt;&lt;br&gt;&lt;b&gt;Foreign Keys (FK)&lt;/b&gt;&lt;br&gt;• Orders.ProductID → Products.ProductID&lt;br&gt;• Orders.CustomerID → Customers.CustomerID&lt;br&gt;• Orders.SalesPersonID → Employees.EmployeeID&lt;br&gt;• Employees.ManagerID → Employees.EmployeeID (self-reference)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#F9F9F9;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="500" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="box_rel" value="&lt;b&gt;Relationships and cardinality&lt;/b&gt;&lt;br&gt;1) Customers 1 : N Orders — one customer can place many orders; every order belongs to exactly one customer (Orders.CustomerID).&lt;br&gt;2) Products 1 : N Orders — a product can appear in many order records; each order record refers to exactly one product (Orders.ProductID).&lt;br&gt;3) Employees 1 : N Orders — one sales employee can process many orders; each order is assigned to exactly one sales employee (Orders.SalesPersonID).&lt;br&gt;4) Employees (manager) 1 : N Employees (self-reference) — a manager can supervise several employees; each employee has at most one manager (ManagerID, NULL for a top-level manager).&lt;br&gt;&lt;br&gt;&lt;i&gt;Legend: || = exactly one; crow's foot with circle = zero or many; circle with bar = zero or one.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#F9F9F9;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="480" width="640" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
