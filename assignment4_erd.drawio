        <mxCell id="e_emp_manager" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERzeroToOne;startArrow=ERzeroToMany;endFill=0;startFill=0;startSize=12;endSize=12;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontStyle=1;fontSize=12;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="emp_r7" target="emp_r0">
