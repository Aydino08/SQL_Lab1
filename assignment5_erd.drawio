        <!-- ================= RELATIONSHIPS ================= -->
        <!-- Students 1 : N Enrollments -->
        <mxCell id="e_stu_enr" value="1 : N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=ERmandOne;startArrow=ERzeroToMany;endFill=0;startFill=0;startSize=12;endSize=12;strokeWidth=2;strokeColor=#333333;labelBackgroundColor=#FFFFFF;fontStyle=1;fontSize=12;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="enr_r1" target="stu_r0">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="179"/>
              <mxPoint x="340" y="153"/>
            </Array>
          </mxGeometry>
        </mxCell>

