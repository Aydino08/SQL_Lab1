        <!-- Students M : N Courses (logical, resolved by Enrollments) -->
        <mxCell id="e_stu_crs_mn" value="M : N (via Enrollments)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;dashPattern=6 4;startArrow=ERmany;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeWidth=2;strokeColor=#888888;labelBackgroundColor=#FFFFFF;fontStyle=1;fontSize=12;fontColor=#666666;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="tbl_students" target="tbl_courses">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="165" y="75"/>
              <mxPoint x="865" y="75"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ================= EXPLANATION ================= -->
        <mxCell id="box_keys" value="&lt;b&gt;Primary Keys (PK)&lt;/b&gt;&lt;br&gt;• Students.StudentID&lt;br&gt;• Instructors.InstructorID&lt;br&gt;• Courses.CourseID&lt;br&gt;• Enrollments.EnrollmentID&lt;br&gt;&lt;br&gt;&lt;b&gt;Foreign Keys (FK)&lt;/b&gt;&lt;br&gt;• Courses.InstructorID → Instructors.InstructorID&lt;br&gt;• Enrollments.StudentID → Students.StudentID&lt;br&gt;• Enrollments.CourseID → Courses.CourseID&lt;br&gt;&lt;br&gt;&lt;b&gt;Unique key (UQ)&lt;/b&gt;&lt;br&gt;• Enrollments (StudentID, CourseID) — composite" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#F9F9F9;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="400" width="380" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="box_rel" value="&lt;b&gt;Relationships and cardinality&lt;/b&gt;&lt;br&gt;1) Instructors 1 : N Courses — an instructor may teach several courses, but each course is taught by exactly one instructor (Courses.InstructorID).&lt;br&gt;2) Students 1 : N Enrollments — one student can have many enrollment records (one for each course taken); each enrollment record belongs to exactly one student (Enrollments.StudentID).&lt;br&gt;3) Courses 1 : N Enrollments — one course can have many enrollment records (one for each registered student); each enrollment record refers to exactly one course (Enrollments.CourseID).&lt;br&gt;4) Students M : N Courses (logical) — a student can register for several courses and a course can have several students; this many-to-many relationship is resolved by the Enrollments table, so it is not a direct physical link.&lt;br&gt;&lt;br&gt;&lt;i&gt;Legend: || = exactly one; crow's foot with circle = zero or many; dashed line = logical M:N relationship.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#F9F9F9;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="440" y="400" width="900" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="box_enroll" value="&lt;b&gt;How Enrollments represents registrations&lt;/b&gt;&lt;br&gt;Enrollments is a junction (associative) table. Each row links exactly one student to exactly one course and stores the registration details (EnrollmentDate, Grade, Status). A student's courses are found through the Enrollments rows that contain the student's ID, and a course's students through the rows that contain the course's ID.&lt;br&gt;&lt;br&gt;&lt;b&gt;Preventing duplicate registrations&lt;/b&gt;&lt;br&gt;A composite UNIQUE constraint on (StudentID, CourseID) in Enrollments lets each student–course pair appear only once, so a student cannot be registered twice for the same course. EnrollmentID remains the primary key of each enrollment record." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;strokeColor=#999999;fillColor=#F9F9F9;spacing=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="655" width="1300" height="135" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
